# ===========================================
# Domain Sniper - 환경 설정 파일
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env
# ===========================================

# ----- 프로그램 정보 -----
PROGRAM_NAME=Domain Sniper
PROGRAM_VERSION=1.0.0

# ----- Telegram 설정 (필수) -----
# BotFather에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 알림 받을 채팅방 ID (봇과 대화 후 @userinfobot으로 확인)
TELEGRAM_CHAT_ID=your_chat_id_here

# ----- Discord 설정 (선택) -----
# 서버 설정 > 연동 > 웹후크에서 생성
DISCORD_WEBHOOK_URL=

# ----- ExpiredDomains.net 로그인 (필수) -----
# https://www.expireddomains.net/register/ 에서 무료 계정 생성
EXPIRED_DOMAINS_USERNAME=your_username_here
EXPIRED_DOMAINS_PASSWORD=your_password_here

# ----- 웹 대시보드 설정 -----
# 웹 대시보드 활성화
WEB_ENABLED=true

# 웹 대시보드 포트
WEB_PORT=8000

# 웹 대시보드 호스트 (0.0.0.0이면 외부 접근 허용)
WEB_HOST=0.0.0.0

# 웹 대시보드 인증 (비밀번호가 비어있으면 인증 비활성화)
WEB_USERNAME=admin
WEB_PASSWORD=

# ----- 프록시 설정 (선택) -----
# 프록시 사용 여부
USE_PROXY=false

# 프록시 목록 (쉼표로 구분)
# 예: http://user:pass@proxy1:8080,http://proxy2:8080
PROXY_LIST=

# ----- 도메인 확인 설정 -----
# 도메인 가용성 자동 확인 (RDAP/WHOIS)
CHECK_AVAILABILITY=true

# 도메인 히스토리 자동 확인 (Archive.org)
CHECK_HISTORY=true

# ----- 데이터베이스 설정 -----
# SQLite 데이터베이스 파일 경로
DATABASE_PATH=domains.db

# ----- 로깅 설정 -----
# 로그 파일 경로 (비우면 콘솔만 출력)
LOG_FILE_PATH=logs/domain-sniper.log

# ----- 고급 설정 -----
# HTTP 요청 타임아웃 (초)
HTTP_TIMEOUT=30

# HTTP 요청 재시도 횟수
HTTP_RETRY_COUNT=3

# 요청 간 딜레이 (초) - 서버 부하 방지
REQUEST_DELAY=2.0

# User-Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ===========================================
# 참고: 아래 설정들은 웹 대시보드에서 관리됩니다
# (data/runtime_settings.json 파일에 저장)
# - 크롤링 스케줄 (전체/7일/1일 스캔)
# - 도메인 필터 (길이, TLD, 숫자/하이픈 허용)
# - 알림 설정 (최소 점수, 일일 리포트, 하트비트)
# - 로그 레벨
# ===========================================
