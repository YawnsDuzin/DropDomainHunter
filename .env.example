# ===========================================
# Domain Sniper - 환경 설정 파일
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env
# ===========================================

# ----- Telegram 설정 (필수) -----
# BotFather에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 알림 받을 채팅방 ID (봇과 대화 후 @userinfobot으로 확인)
TELEGRAM_CHAT_ID=your_chat_id_here

# ----- Discord 설정 (선택) -----
# 서버 설정 > 연동 > 웹후크에서 생성
DISCORD_WEBHOOK_URL=

# ----- 크롤링 설정 -----
# 전체 스캔 주기 (시간)
CRAWL_FULL_INTERVAL_HOURS=24

# 7일 이내 만료 도메인 스캔 주기 (시간)
CRAWL_WEEK_INTERVAL_HOURS=3

# 1일 이내 만료 도메인 스캔 주기 (분)
CRAWL_DAY_INTERVAL_MINUTES=30

# ----- 도메인 필터 -----
# 최소 도메인 길이
MIN_DOMAIN_LENGTH=3

# 최대 도메인 길이
MAX_DOMAIN_LENGTH=12

# 허용 TLD (쉼표 구분)
ALLOWED_TLDS=com,net,io,co,kr

# 숫자 포함 도메인 허용
ALLOW_NUMBERS=false

# 하이픈 포함 도메인 허용
ALLOW_HYPHENS=false

# ----- 알림 설정 -----
# 알림 최소 점수 (0-100)
MIN_SCORE_ALERT=70

# 일일 요약 리포트 시간 (HH:MM)
DAILY_REPORT_TIME=08:00

# 하트비트 알림 간격 (분, 0이면 비활성화)
HEARTBEAT_INTERVAL_MINUTES=0

# ----- 웹 대시보드 설정 (선택) -----
# 웹 대시보드 활성화
WEB_ENABLED=true

# 웹 대시보드 포트
WEB_PORT=8000

# 웹 대시보드 호스트 (0.0.0.0이면 외부 접근 허용)
WEB_HOST=0.0.0.0

# ----- 데이터베이스 설정 -----
# SQLite 데이터베이스 파일 경로
DATABASE_PATH=domains.db

# ----- 로깅 설정 -----
# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 로그 파일 경로 (비우면 콘솔만 출력)
LOG_FILE_PATH=logs/domain-sniper.log

# ----- 고급 설정 -----
# HTTP 요청 타임아웃 (초)
HTTP_TIMEOUT=30

# HTTP 요청 재시도 횟수
HTTP_RETRY_COUNT=3

# 요청 간 딜레이 (초) - 서버 부하 방지
REQUEST_DELAY=2.0

# User-Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
